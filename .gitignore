# ==============================================================================
# Campus Emergency Platform (.gitignore)
# Working Identifier: campus-emergency-platform
# Team Nexus - Development Governance & Security Standard
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.pfx
*.p12
id_rsa*
secrets/
credentials.json

# ------------------------------------------------------------------------------
# 2. Node.js & Frontend Artifacts
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
.vite/
.output/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.tmp

# ------------------------------------------------------------------------------
# 3. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Python Testing & Coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Python Packaging
*.egg-info/
dist/
eggs/
.eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 4. Operating System & Filesystem Junk
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------------------------------------------
# 5. IDE & Editor Artifacts
# ------------------------------------------------------------------------------
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# VS Code (preserve team configuration if committed)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# 6. Temporary Files, Caches & Scratch Data
# ------------------------------------------------------------------------------
*.log
*.tmp
*.bak
scratch/
tmp/
temp/
