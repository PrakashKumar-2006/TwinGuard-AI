# ==============================================================================
# Campus Emergency Platform Environment Variables Template
# Working Identifier: campus-emergency-platform
# Team Nexus - Development Governance & Security Standard
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env`:
#    cp .env.example .env
# 2. Never commit actual `.env` files with secrets or real credentials to Git.
# 3. Only safe placeholder defaults are provided in this template.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General & Runtime Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Backend API Service (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_PREFIX=/api/v1

# Allowed CORS Origins (comma-separated list for frontend dev servers)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Simulation & Optimization Parameters
# ------------------------------------------------------------------------------
# Default integer seed for reproducible, deterministic simulation runs
SIMULATION_RANDOM_SEED_DEFAULT=42

# Time resolution per simulation step in seconds (e.g. 0.5s or 1.0s)
SIMULATION_TIME_STEP_SECONDS=0.5

# Unimpeded pedestrian walking speed standard (meters per second)
DEFAULT_WALKING_SPEED_MPS=1.3

# ------------------------------------------------------------------------------
# 4. Frontend Client (Vite: must start with VITE_)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_3D_TWIN=true
VITE_DEBUG_OVERLAY=false

# ------------------------------------------------------------------------------
# 5. Future Persistence (PROPOSED - Deferred for Prototype Phase)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_emergency
